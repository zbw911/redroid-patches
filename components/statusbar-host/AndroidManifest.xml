<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.buildploy.statusbarprobe.host" android:versionCode="2" android:versionName="2.0-appearance-prototype">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application android:label="Isolated Status Bar Window Host" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <activity android:name=".HostActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <receiver android:name=".Commands" android:exported="true" android:permission="android.permission.STATUS_BAR_SERVICE" />
        <receiver android:name=".AppearanceEvents" android:exported="true" android:permission="android.permission.STATUS_BAR_SERVICE" />
    </application>
</manifest>
